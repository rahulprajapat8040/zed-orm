{
  "name": "@zed-orm/driver-mysql",
  "version": "0.1.0",
  "description": "MySQL driver for Zed ORM",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zed-orm/runtime": "workspace:*",
    "@zed-orm/shared": "workspace:*",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10"
  }
}
