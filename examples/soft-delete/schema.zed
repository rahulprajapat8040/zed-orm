datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "zed-client"
  output   = "generated/zed"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  deletedAt DateTime?
  posts     Post[]

  @@softDelete
}

model Post {
  id        String    @id @default(uuid())
  title     String
  authorId  String
  deletedAt DateTime?
  author    User      @relation(fields: [authorId], references: [id], onSoftDelete: Cascade)

  @@softDelete
}
